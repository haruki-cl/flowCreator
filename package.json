{
  "name": "flow-creator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:viewer": "vite build -c vite.viewer.config.ts",
    "dev": "npm run build:viewer && vite",
    "build": "npm run build:viewer && tsc -b && vite build",
    "preview": "vite preview",
